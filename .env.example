# Environment-variable names only. Never commit real values.
# The application does not automatically load .env files.

# Non-negotiable runtime policy
FREE_ONLY_MODE=true
PAID_FALLBACK_ENABLED=false
MEMORY_ENABLED=false
DELIVERY_ENABLED=false
LINE_ENABLED=false

# LINE Messaging API credentials for the shared webhook only. The repository has
# no owner-report push sender and stores no raw LINE user ID. Friend admission is
# based only on HMAC-derived tenant hashes.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Shared-bot admission. Default disabled. The only enabled mode is an
# HMAC-derived allowlist for explicitly admitted friends; raw LINE IDs are never
# stored. Group and room chats are always rejected by code and are not
# configurable.
LINE_ACCESS_MODE=disabled
LINE_ALLOWED_TENANT_HASHES=

# Tenant isolation for optional conversation memory/jobs only. Both values are
# required before allowlist mode can answer. They do not grant access to
# portfolio, account, IBKR or broker data.
TENANT_HASH_SECRET=
TENANT_DATA_ENCRYPTION_KEY=

# Local zero-per-request model; do not expose llama.cpp directly to the Internet.
# The Worker accepts only an exact HTTPS hostname in LOCAL_LLM_ALLOWED_HOSTS,
# rejects IP literals/non-443 ports/redirects, and requires an API key or shared
# secret. Only public snapshots and the current tenant's own opt-in conversation
# history may enter model context.
LOCAL_LLAMACPP_URL=http://127.0.0.1:8813
LOCAL_MODEL_ENABLED=true
LOCAL_LLM_BASE_URL=
LOCAL_LLM_ALLOWED_HOSTS=
LOCAL_LLM_MODEL=qwen3.8-27b
LOCAL_LLM_API_KEY=
LOCAL_LLM_SHARED_SECRET=

# Optional local-only IBKR Client Portal provider. It is never connected to LINE,
# Worker or public KV. No IBKR-derived record is eligible for the LINE snapshot.
OPTIONS_PROVIDER=auto
OPTIONS_ALLOW_FALLBACK=true
IBKR_READONLY_ENABLED=false
IBKR_CP_BASE_URL=https://127.0.0.1:5000/v1/api
IBKR_CP_VERIFY_TLS=false
PORTFOLIO_JSON=

# LINE uses separate owner-independent public artifacts. Legacy owner/watchlist
# pipeline files are never fallbacks. Public KV publication is validation-only by
# default; a write requires both the command-line --apply flag and this switch.
LINE_PUBLIC_SYMBOLS_PATH=config/line-public-symbols.json
LINE_PUBLIC_OPTIONS_PATH=data/cache/options_public_latest.json
PUBLIC_KV_SYNC_ENABLED=false

# Current-data questions fail closed until a reviewed public adapter is enabled.
CURRENT_PUBLIC_DATA_ENABLED=false
PUBLIC_DATA_MAX_AGE_SECONDS=1800
OPTION_DATA_MAX_AGE_SECONDS=1800

# Cloudflare Workers Free storage/edge only. No Workers AI binding or paid fallback.
CLOUDFLARE_PLAN=workers_free
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_URL=
WORKERS_DAILY_REQUEST_SOFT_LIMIT=90000
KV_DAILY_WRITE_SOFT_LIMIT=800

# SEC EDGAR requires a descriptive User-Agent with contact information.
SEC_USER_AGENT=InvestorIntelligence/2.0 contact@example.com
