{
  "schema_version": 1,
  "policy_id": "industry-rotation-v1",
  "authorship": "PROJECT_AUTHORED_DATA_DERIVED",
  "description": "Industry universe defined by official classifications only (SEC SIC membership, BLS PPI industry series). No industry, score, narrative or beneficiary is written by hand; every value is computed from the latest official data at run time.",
  "sources": {
    "bls_ppi": {
      "publisher": "U.S. Bureau of Labor Statistics, Producer Price Index (public domain)",
      "endpoint": "https://api.bls.gov/publicAPI/v1/timeseries/data/",
      "series_page": "https://data.bls.gov/timeseries/{series}",
      "max_series_per_request": 25
    },
    "sec_xbrl_frames": {
      "publisher": "U.S. SEC EDGAR XBRL frames (issuer filings)",
      "endpoint": "https://data.sec.gov/api/xbrl/frames/us-gaap/{concept}/USD/{period}.json"
    },
    "sec_sic_members": {
      "publisher": "U.S. SEC EDGAR company listing by SIC",
      "endpoint": "https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&SIC={sic}&type=10-K&dateb=&owner=include&count=100&start={start}&output=atom",
      "max_pages": 10,
      "page_size": 100
    },
    "taiwan_monthly_revenue": {
      "publisher": "臺灣證券交易所與證券櫃檯買賣中心 OpenAPI 上市櫃公司每月營業收入彙總表（政府資料開放授權條款）",
      "endpoints": [
        "https://openapi.twse.com.tw/v1/opendata/t187ap05_L",
        "https://www.tpex.org.tw/openapi/v1/mopsfin_t187ap05_O"
      ]
    }
  },
  "concepts": {
    "backlog": [
      "RevenueRemainingPerformanceObligation"
    ],
    "inventory": [
      "InventoryNet"
    ],
    "revenue": [
      "RevenueFromContractWithCustomerExcludingAssessedTax",
      "Revenues"
    ]
  },
  "thresholds": {
    "ppi_up_yoy_pct": 3.0,
    "ppi_down_yoy_pct": -3.0,
    "backlog_up_yoy_pct": 10.0,
    "backlog_down_yoy_pct": -10.0,
    "inventory_build_gap_pp": 10.0,
    "min_matched_issuers": 3,
    "min_frame_rows": 300,
    "rotation_max_age_days": 45,
    "refresh_min_hours": 20,
    "min_admission_strength": 15,
    "tw_revenue_up_yoy_pct": 20.0,
    "tw_revenue_down_yoy_pct": -10.0
  },
  "strength_formula": {
    "price_yoy_cap_pct": 20.0,
    "price_points_per_pct": 2.0,
    "backlog_yoy_cap_pct": 50.0,
    "backlog_points_per_pct": 0.8,
    "revenue_yoy_cap_pct": 40.0,
    "revenue_points_per_pct": 0.5,
    "inventory_gap_penalty_cap": 20.0,
    "tw_revenue_yoy_cap_pct": 40.0,
    "tw_revenue_points_per_pct": 0.25
  },
