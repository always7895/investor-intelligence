{
  "schema_version": 1,
  "timezone": "Asia/Taipei",
  "scheduler_enabled": false,
  "automatic_task_registration": false,
  "development_dry_run_only": true,
  "overlap_policy": "skip_if_previous_run_active",
  "clock_rollback_behavior": "fail_closed",
  "missed_run_behavior": "single_bounded_catch_up",
  "maximum_catch_up_jobs": 1,
  "retry_policy": {
    "maximum_attempts": 3,
    "initial_backoff_seconds": 60,
    "maximum_backoff_seconds": 900,
    "jitter_seconds": 30,
    "retryable_categories": [
      "TRANSIENT_NETWORK",
      "RATE_LIMITED",
      "UPSTREAM_5XX"
    ],
    "non_retryable_categories": [
      "PRIVACY_BOUNDARY",
      "RIGHTS_REVIEW_REQUIRED",
      "SCHEMA_CHANGED",
      "PAID_FALLBACK_REQUIRED",
      "AUTHORIZATION_FAILURE"
    ]
  },
  "jobs": [
    {
      "id": "public_morning_briefing",
      "local_time": "07:30",
      "days": [1, 2, 3, 4, 5],
      "command": "python scripts/generate_public_briefing.py",
      "network_access": false,
      "requires_public_snapshot": true,
      "delivery": false,
      "enabled": false
    },
    {
      "id": "public_evening_briefing",
      "local_time": "20:30",
      "days": [1, 2, 3, 4, 5],
      "command": "python scripts/generate_public_briefing.py",
      "network_access": false,
      "requires_public_snapshot": true,
      "delivery": false,
      "enabled": false
    },
    {
      "id": "authoritative_source_health",
      "local_time": "06:45",
      "days": [1, 2, 3, 4, 5, 6, 7],
      "command": "python scripts/authoritative_source_catalog.py --validate",
      "network_access": false,
      "requires_public_snapshot": false,
      "delivery": false,
      "enabled": false
    },
    {
      "id": "release_truth_audit",
      "local_time": "03:15",
      "days": [1, 2, 3, 4, 5, 6, 7],
      "command": "python scripts/release_candidate_gate.py",
      "network_access": false,
      "requires_public_snapshot": false,
      "delivery": false,
      "enabled": false
    }
  ]
}
