{
  "schema_version": 1,
  "product_version": "2.1.3",
  "policy_id": "v213-live-source-federation-v1",
  "catalog_source_count_is_not_live_use": true,
  "automatic_source_activation": false,
  "public_only": true,
  "free_only_required": true,
