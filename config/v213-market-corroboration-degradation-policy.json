    "degradation_code_must_be_present": true,
    "uncorroborated_rows_high_confidence_eligible": false,
    "uncorroborated_rows_model_inference_confidence": "LIMITED",
    "uncorroborated_rows_missing_evidence_code": "NON_YAHOO_MARKET_CORROBORATION",
