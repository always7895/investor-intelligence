  "target_non_yahoo_market_coverage_ratio": 0.75,
  "market_corroboration_unavailable_is_global_blocker": false,
  "market_corroboration_required_for_high_confidence_model_inference": true,
  "market_corroboration_required_for_uncapped_valuation_factor": true,
  "uncorroborated_valuation_factor_max": 3.75,
  "degradation_code": "INSUFFICIENT_NON_YAHOO_MARKET_COVERAGE",
  "provider_failure_must_be_disclosed": true,
  "provider_failure_must_not_be_silently_relabelled_as_success": true,
  "market_data_never_proves_company_claim": true,
  "market_data_never_proves_dependency_or_bottleneck": true,
  "market_data_is_not_averaged_into_published_returns": true,
  "source_conflicts_are_not_averaged": true,
  "blocking_requirements_preserved": [
    "portfolio_independent_source_families",
    "portfolio_independent_domains",
    "portfolio_claim_source_families",
    "portfolio_claim_source_domains",
