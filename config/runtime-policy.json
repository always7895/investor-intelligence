{
  "schema_version": 3,
  "privacy": {
    "multi_tenant": true,
    "tenant_id_derivation": "hmac_sha256",
    "raw_user_id_in_logs": false,
    "message_text_in_logs": false,
    "answer_text_in_logs": false,
    "default_memory": "unavailable",
    "memory_feature_available_for_initial_external_release": false,
    "private_memory_max_ttl_seconds": 86400,
    "cross_tenant_cache": false,
    "global_cache_public_inputs_only": true,
    "physical_namespace_separation": true,
    "public_cache_binding": "PUBLIC_CACHE",
    "tenant_private_cache_binding": "TENANT_PRIVATE_CACHE",
    "ephemeral_security_cache_binding": "EPHEMERAL_SECURITY_CACHE",
    "legacy_combined_cache_binding_allowed": false,
    "group_chat_enabled": false,
    "owner_data_available_to_line": false,
    "owner_watchlist_inherited_by_line": false,
    "portfolio_available_to_line": false,
    "broker_account_available_to_line": false,
    "private_sync_available_to_line": false,
    "arbitrary_model_context_includes_option_chains": false,
    "first_person_financial_disclosure_behavior": "reject_without_model_or_storage",
    "unauthenticated_health_exposes_operational_metadata": false,
    "private_storage_encryption": "aes_gcm",
    "delete_my_data_command_required": true
  },
  "authorization": {
    "default_line_access_mode": "disabled",
    "supported_line_access_modes": [
      "disabled",
      "allowlist"
    ],
    "allowlist_uses_hmac_tenant_ids": true,
    "direct_chat_only": true,
    "unauthorized_event_behavior": "silent_fail_closed",
    "missing_tenant_secret_behavior": "silent_fail_closed",
    "model_cannot_elevate_access": true,
    "owner_or_operator_role_exists_in_shared_bot": false,
    "automatic_trading": false
  },
  "cost": {
    "mode": "free_only_fail_closed",
    "paid_fallback": false,
    "automatic_plan_upgrade": false,
    "payment_method_required": false,
    "paid_model_api_allowed": false,
    "paid_market_data_required": false,
    "paid_news_required": false,
    "github_hosted_runners_allowed": false,
    "github_actions_artifacts_required": false,
    "line_reply_first": true,
    "line_push_default": false,
    "cloudflare_plan": "workers_free",
    "workers_daily_request_soft_limit": 90000,
    "kv_daily_write_soft_limit": 800
  },
  "models": {
    "local": {
      "provider": "llama.cpp",
      "visibility": "private",
      "per_request_fee": 0,
      "required_for_general_qa": true,
      "context_scope": "public_snapshot_plus_current_tenant_opt_in_memory_when_available",
      "option_chains_in_arbitrary_context": false,
      "allowed_hosts_required": true,
      "authenticated_route_required": true,
      "ip_literal_hosts_allowed": false,
      "non_443_ports_allowed": false,
      "redirects_allowed": false
    },
    "cloud": {
      "enabled": false,
      "paid_plan_models_allowed": false,
      "fallback_when_unavailable": "controlled_degraded_response"
    }
  },
  "line": {
    "free_plan_only": true,
    "reply_messages_default": true,
    "push_messages_enabled": false,
    "additional_paid_messages_allowed": false,
    "quota_exhaustion_behavior": "fail_closed",
    "options_dataset": "data/cache/options_public_latest.json",
    "options_scope": "public_quote_observation_only",
    "ibkr_bridge": false,
    "brokerage_connection": false,
    "portfolio_tools": false,
    "private_sync_route": false
  },
  "data": {
    "required_sources_must_be_free": true,
    "paywall_bypass": false,
    "premium_api_dependency": false,
    "stale_data_must_be_labelled": true,
    "line_public_symbols_catalog": "config/line-public-symbols.json",
    "line_public_symbols_inherit_owner_watchlist": false,
    "line_public_metadata_dataset": "data/cache/public_snapshot_metadata.json",
    "line_public_scores_dataset": "data/cache/scores_public_latest.json",
    "line_public_options_dataset": "data/cache/options_public_latest.json",
    "line_public_source_views_dataset": "data/cache/source_views_public_latest.json",
    "line_public_reports_require_attestations": true,
    "line_public_legacy_artifact_fallback": false,
    "line_public_freshness_uses_attested_metadata": true,
    "line_public_manifest_contains_sha256": true,
    "line_public_sync_default_dry_run": true,
    "line_public_sync_requires_apply_and_env_gate": true,
    "line_public_sync_target_binding": "PUBLIC_CACHE",
    "line_option_snapshot_rejects_broker_lineage": true,
    "line_option_snapshot_rejects_position_fields": true,
    "line_option_snapshot_requires_public_eligibility_marker": true
  },
  "local_broker_runtime": {
    "ibkr_readonly_may_exist_locally": true,
    "line_or_worker_may_call_ibkr": false,
    "ibkr_output_may_enter_public_kv": false,
    "ibkr_output_may_enter_line_model_context": false,
    "broker_write_paths": false
  },
  "release": {
    "install_local_project_before_final_acceptance": false,
    "final_delivery_format": "versioned_zip_and_private_github_release",
    "include_secrets": false,
    "include_user_data": false,
    "include_runner_state": false,
    "require_cross_tenant_privacy_acceptance": true,
    "require_line_broker_separation_acceptance": true,
    "require_physical_kv_namespace_acceptance": true,
    "require_fresh_namespace_migration": true,
    "copy_legacy_combined_kv": false
  }
}
