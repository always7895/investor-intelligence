    "keyword_cannot_prove_bottleneck": true,
    "gross_margin_cannot_prove_replacement_friction": true,
    "revenue_growth_cannot_prove_tam_capture": true,
    "missing_evidence_is_not_positive": true,
    "social_post_cannot_prove_company_fact": true,
    "quantitative_overlay_cannot_override_broken_thesis": true,
    "foreign_listing_cannot_be_excluded_for_missing_sec_companyfacts": true,
    "disconfirmation_conditions_required": true,
    "dependency_claim_requires_evidence_binding": true,
    "killer_claim_requires_evidence_binding": true,
    "commercial_claim_requires_evidence_binding": true,
    "graph_edge_requires_evidence_binding": true,
    "architecture_requires_dated_evidence_for_bottleneck_class": true,
    "company_capture_requires_evidence": true,
    "source_delta_must_be_chronological_within_snapshot": true,
    "cross_run_append_only_requires_persistent_history": true,
    "evidence_without_https_provenance_is_not_proof": true,
    "signal_evidence_requires_date": true,
    "retrieved_source_view_requires_published_date": true,
    "company_capture_state_cannot_break_without_supported_killer": true,
    "consensus_requires_information_gap_and_validation_context": true,
    "beneficiary_claim_requires_evidence_binding": true,
    "unproven_thesis_cannot_reach_validation_states": true,
    "retrieved_source_delta_requires_nonempty_source_view_and_horizon": true,
    "portfolio_source_policy_failure_caps_model_confidence": true,
    "official_macro_cannot_satisfy_company_primary_requirement": true,
    "single_source_high_confidence_is_forbidden": true
  },
  "output_requirements": {
    "show_source_families": true,
    "show_claim_source_families": true,
    "show_independent_domain_count": true,
    "show_claim_primary_coverage": true,
