      "named_contract",
      "customer_supplier_disclosure",
      "audited_statement",
      "official_roadmap",
      "official_capacity_or_qualification"
    ],
    "corroborating": [
      "adjacent_company_call",
      "government_document",
      "credible_technical_publication",
      "credible_industry_publication",
      "redistributable_institutional_research"
    ],
    "lead_only": [
      "social_post",
      "search_snippet",
      "price_action",
      "community_summary",
      "unnamed_rumor"
    ]
  },
  "source_rules": {
    "duplicate_syndication_counts_once": true,
    "same_registrable_domain_counts_once_per_claim": true,
    "same_corporate_source_family_is_not_independent_corroboration": true,
    "social_post_proves_author_statement_only": true,
    "aggregator_market_data_cannot_prove_bottleneck": true,
    "one_market_provider_cannot_receive_high_data_quality": true,
    "direct_regulatory_or_issuer_disclosure_may_establish_a_narrow_disclosed_fact": true,
    "broader_inference_requires_independent_corroboration": true,
    "official_macro_is_context_not_company_claim_evidence": true,
    "market_price_is_not_dependency_or_capture_evidence": true,
    "conflicting_primary_sources_force_review": true,
    "source_conflicts_are_not_averaged": true,
    "unknown_remains_unknown": true
  },
  "minimums": {
    "portfolio_independent_source_families": 3,
    "portfolio_independent_domains": 3,
    "portfolio_claim_source_families": 2,
    "portfolio_claim_source_domains": 2,
    "portfolio_claim_primary_coverage_ratio": 0.75,
    "non_yahoo_market_coverage_ratio": 0.75,
    "high_confidence_claim_independent_families": 2,
    "high_confidence_claim_independent_domains": 2,
    "high_confidence_claim_primary_sources": 1,
    "high_confidence_claim_dated_ratio": 0.8,
    "dated_evidence_ratio": 0.8,
    "maximum_single_family_share": 0.7,
    "maximum_claim_family_share": 0.7
  },
  "market_data": {
    "calculation_source": "existing_yfinance_adjusted_close",
    "calculation_source_role": "compatibility_calculation_only_not_thesis_evidence",
    "required_independent_corroboration": [
      "stooq_daily_csv",
      "nasdaq_historical_api",
      "optional_alpha_vantage_adjusted"
    ],
    "official_macro_context": "fred_official_macro",
    "corroboration_is_not_averaged_into_returns": true,
    "conflict_behavior": "flag_and_reduce_confidence",
    "cache_max_age_hours": 72,
    "long_term_absolute_tolerance_percentage_points": 30.0,
    "short_term_absolute_tolerance_percentage_points": 18.0
  },
  "sensitive_claims": {
    "chokepoint": {
      "requires_dependency_graph_edge": true,
      "requires_primary_evidence": true,
      "requires_independent_corroboration": true,
      "disallowed_shortcuts": [
        "keyword_only",
        "sector_label_only",
        "gross_margin_only",
        "revenue_growth_only",
        "named_customer_only",
        "price_action_only",
        "short_interest_only"
      ]
    },
    "company_capture": {
      "tests": [
        "qualified_capacity_or_share",
        "pricing_or_contract_structure",
        "financing_durability",
        "bom_or_product_mix",
        "vertical_integration",
        "customer_concentration",
        "execution_and_capex",
        "architecture_bypass_risk"
      ]
    },
    "thesis_killers": {
      "tests": [
        "dilution_or_atm",
        "toxic_financing",
        "customer_loss",
        "architecture_bypass",
        "new_qualified_competitor",
        "qualification_or_volume_delay",
        "scarcity_removal",
        "pricing_collapse",
        "jurisdiction_or_export_risk",
        "funding_failure",
        "factual_contradiction"
      ],
      "severe_evidence_bound_killer_can_override_positive_score": true
    }
  },
  "graph_edge_required_fields": [
    "from",
    "to",
    "relationship",
    "evidence_url",
    "as_of"
  ],
  "signal_evidence_required_fields": [
