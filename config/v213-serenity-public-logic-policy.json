    "stance",
    "horizon",
    "what_changed_vs_prior_source_view",
    "retrieval_status"
  ],
  "source_delta_stances": [
    "positive",
    "negative",
    "mixed",
    "neutral",
    "unknown"
  ],
  "source_delta_retrieval_states": [
    "retrieved",
    "unavailable",
    "lead_only"
  ],
  "global_universe": {
    "exchange_agnostic": true,
    "examples": [
