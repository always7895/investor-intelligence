{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/investor-intelligence/authoritative-source-catalog.schema.json",
  "title": "Investor Intelligence Authoritative Source Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_policy", "runtime_defaults", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_fixed_source_count_limit",
        "automatic_activation",
        "free_only",
        "public_data_only",
        "paywall_bypass_forbidden",
        "runtime_enable_requires_all_gates",
        "unknown_fields_fail_closed"
      ],
      "properties": {
        "no_fixed_source_count_limit": { "const": true },
        "automatic_activation": { "const": false },
        "free_only": { "const": true },
        "public_data_only": { "const": true },
        "paywall_bypass_forbidden": { "const": true },
        "runtime_enable_requires_all_gates": { "const": true },
        "unknown_fields_fail_closed": { "const": true }
      }
    },
    "runtime_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_total_requests",
        "max_total_response_bytes",
        "max_wall_seconds",
        "max_requests_per_host",
        "max_concurrency_per_host",
        "max_retries_per_request",
        "connect_timeout_seconds",
        "read_timeout_seconds"
      ],
      "properties": {
        "max_total_requests": { "type": "integer", "minimum": 1 },
        "max_total_response_bytes": { "type": "integer", "minimum": 1024 },
        "max_wall_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_requests_per_host": { "type": "integer", "minimum": 1 },
        "max_concurrency_per_host": { "type": "integer", "minimum": 1, "maximum": 8 },
        "max_retries_per_request": { "type": "integer", "minimum": 0, "maximum": 4 },
        "connect_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "read_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_reviewed",
        "rights_reviewed",
        "free_access_verified",
        "schema_reviewed",
        "privacy_reviewed",
        "adapter_tests_passed",
        "runtime_health_passed"
      ],
      "properties": {
        "authority_reviewed": { "type": "boolean" },
        "rights_reviewed": { "type": "boolean" },
        "free_access_verified": { "type": "boolean" },
        "schema_reviewed": { "type": "boolean" },
        "privacy_reviewed": { "type": "boolean" },
        "adapter_tests_passed": { "type": "boolean" },
        "runtime_health_passed": { "type": "boolean" }
      }
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "requests_per_minute", "requests_per_day"],
      "properties": {
        "policy": {
          "enum": ["documented", "official_unspecified", "free_key_plan", "bulk_download"]
        },
        "requests_per_minute": { "type": ["integer", "null"], "minimum": 1 },
        "requests_per_day": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "authority",
        "evidence_tier",
        "evidence_role",
        "regions",
        "jurisdictions",
        "topics",
        "claim_types",
        "official_docs_url",
        "base_urls",
        "transport",
        "authentication",
        "credential_env",
        "cost",
        "rights_status",
        "redistribution_status",
        "attribution_required",
        "data_class",
        "adapter_id",
        "adapter_status",
        "runtime_enabled",
        "host_group",
        "freshness_class",
        "update_cadence_seconds",
        "max_requests_per_run",
        "estimated_requests_per_cycle",
        "estimated_response_bytes_per_cycle",
        "estimated_wall_seconds_per_cycle",
        "rate_limit",
        "gates",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
        "display_name": { "type": "string", "minLength": 3, "maxLength": 160 },
        "authority": { "type": "string", "minLength": 2, "maxLength": 160 },
        "evidence_tier": { "enum": ["T0", "T1", "T2", "T3"] },
        "evidence_role": { "enum": ["direct_primary", "official_statistical", "regulated_market", "public_market_observation", "corroboration_only", "discovery_only"] },
        "regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,31}$" }
        },
        "jurisdictions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,31}$" }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,47}$" }
        },
        "claim_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" }
        },
        "official_docs_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "base_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "transport": { "enum": ["rest_json", "sdmx", "odata", "rss", "bulk_csv", "bulk_json", "bulk_xml", "official_download", "public_search"] },
        "authentication": { "enum": ["none", "free_api_key", "free_registration"] },
        "credential_env": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,95}$" },
        "cost": { "const": "free" },
        "rights_status": { "enum": ["reviewed_public_access", "review_before_enable"] },
        "redistribution_status": { "enum": ["public_attribution", "metadata_only", "review_before_enable"] },
        "attribution_required": { "type": "boolean" },
        "data_class": { "const": "public" },
        "adapter_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
        "adapter_status": { "enum": ["adapter_reviewed", "adapter_replay_required", "catalog_reviewed", "metadata_only", "blocked"] },
        "runtime_enabled": { "type": "boolean" },
        "host_group": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$" },
        "freshness_class": { "enum": ["event_driven", "intraday", "daily", "weekly", "monthly", "quarterly", "annual", "mixed"] },
        "update_cadence_seconds": { "type": "integer", "minimum": 60 },
        "max_requests_per_run": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "estimated_requests_per_cycle": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "estimated_response_bytes_per_cycle": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "estimated_wall_seconds_per_cycle": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
        "rate_limit": { "$ref": "#/$defs/rate_limit" },
        "gates": { "$ref": "#/$defs/gates" },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
